# Storefront configuration — uses the SAME database as the admin panel (pos_inventory_system)
# DB credentials are loaded from backend/utils/config.php; these are optional overrides only.

APP_URL=http://localhost/ShoeInventorySystem/storefront
APP_ENV=development

# 3D customizer: external Vercel URL (default) or local build path
# CUSTOMIZER_URL=https://shoe-customizer-silk.vercel.app
CUSTOMIZER_URL=/ShoeInventorySystem/storefront/3D-shoe-customizer/dist/index.html

# OAuth — redirect URIs must be registered for APP_URL in Google/Facebook consoles

# Copy this file to .env next to config.php (backend/utils/.env) on InfinityFree.
# Fill in the values from your InfinityFree MySQL panel.
# On your local XAMPP, you can leave this file absent — config.php falls back to localhost/root/''.

# InfinityFree gives you these in the MySQL Databases section of the control panel.
DB_HOST=sqlXXX.epizy.com
DB_NAME=epiz_XXXXXXX_pos
DB_USER=epiz_XXXXXXX
DB_PASS=your_db_password_here

# Set to "true" once your site has HTTPS/SSL (InfinityFree provides free SSL).
SESSION_SECURE=false

# On InfinityFree the web root is "/". On local XAMPP it may be "/ShoeInventorySystem".
SESSION_PATH=/

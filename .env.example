# Shoe Inventory System - environment config (COPY TO .env, never commit .env)
# Get DB values from your InfinityFree MySQL Databases panel.

# ---- Database (read by backend/utils/config.php) ----
DB_HOST=sqlxxx.epizy.com
DB_NAME=epiz_xxxxxxx_pos_inventory_system
DB_USER=epiz_xxxxxxx
DB_PASS=your_db_password

# ---- Storefront base URL (used for OAuth redirect URIs) ----
# On InfinityFree this is your subdomain root:
APP_URL=https://yoursite.epizy.net/storefront
APP_ENV=production

# ---- 3D Shoe Customizer (optional) ----
# Build it locally (npm install && npm run build in storefront/3D-shoe-customizer)
# then point this at the built dist:
CUSTOMIZER_URL=/storefront/3D-shoe-customizer/dist/index.html

# ---- Social login (optional) ----
OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- SMTP email (optional, Gmail OAuth) ----
GMAIL_SMTP_USER=
GMAIL_SMTP_REFRESH_TOKEN=
